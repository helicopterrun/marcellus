[Unit]
Description=Marcellus — high-res cross-camera face capture (oneshot)
Documentation=https://github.com/helicopterrun/frigate-sidecar
After=network.target

[Service]
Type=oneshot
# Same dedicated user as frigate-sidecar.service: this job shares that service's
# SQLite DB and writes JPEGs into its data dir, so running it as root would leave
# root-owned WAL files and unreadable captures behind.
User=frigate-sidecar
WorkingDirectory=/opt/frigate-sidecar
Environment="FRIGATE_SIDECAR_CONFIG=/opt/frigate-sidecar/config/sidecar.yml"
ExecStart=/usr/bin/python3 -m frigate_sidecar face-capture scan

