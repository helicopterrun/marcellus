[Unit]
Description=Restart marcellus after repeated /healthz failures
Documentation=https://github.com/helicopterrun/marcellus

[Service]
Type=oneshot
# Reads bind_host/bind_port from the sidecar config and restarts the unit
# after 3 consecutive failures (see the script header for why not 1).
Environment=MARCELLUS_CONFIG=/opt/marcellus/config/sidecar.yml
ExecStart=/usr/local/bin/marcellus-healthcheck
