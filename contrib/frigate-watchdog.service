[Unit]
Description=Frigate Watchdog (restarts the Frigate container on a hung backend)
Documentation=https://github.com/helicopterrun/marcellus
After=network.target docker.service
Wants=docker.service

[Service]
Type=simple
# root so it can run `docker restart frigate`.
User=root
WorkingDirectory=/opt/marcellus
Environment="MARCELLUS_CONFIG=/opt/marcellus/config/sidecar.yml"
ExecStart=/usr/bin/python3 -m marcellus watchdog
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
